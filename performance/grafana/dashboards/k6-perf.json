{
  "uid": "k6-unagent-chat",
  "title": "UNAgent — k6 Chat Load Test",
  "description": "Real-time performance curve for the /v1/chat endpoint under ramp load (10→500 VUs).",
  "tags": ["k6", "performance", "unagent"],
  "timezone": "browser",
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "schemaVersion": 38,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "annotations": { "list": [] },
  "templating": { "list": [] },
  "links": [],
  "panels": [

    {
      "id": 1,
      "title": "Active Virtual Users",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "influxdb", "uid": "influxdb-k6" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "red",    "value": 300 }
            ]
          },
          "unit": "short",
          "mappings": []
        }
      },
      "targets": [
        {
          "refId": "A",
          "query": "SELECT last(\"value\") FROM \"vus\" WHERE $timeFilter",
          "resultFormat": "time_series",
          "rawQuery": true
        }
      ]
    },

    {
      "id": 2,
      "title": "Throughput (req/s)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "influxdb", "uid": "influxdb-k6" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          },
          "unit": "reqps",
          "decimals": 1
        }
      },
      "targets": [
        {
          "refId": "A",
          "query": "SELECT non_negative_derivative(max(\"value\"), 1s) FROM \"http_reqs\" WHERE $timeFilter GROUP BY time(10s) fill(0)",
          "resultFormat": "time_series",
          "rawQuery": true
        }
      ]
    },

    {
      "id": 3,
      "title": "P95 Latency",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "influxdb", "uid": "influxdb-k6" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 2000 },
              { "color": "red",    "value": 5000 }
            ]
          },
          "unit": "ms",
          "decimals": 0
        }
      },
      "targets": [
        {
          "refId": "A",
          "query": "SELECT percentile(\"value\", 95) FROM \"http_req_duration\" WHERE $timeFilter GROUP BY time(10s) fill(null)",
          "resultFormat": "time_series",
          "rawQuery": true
        }
      ]
    },

    {
      "id": 4,
      "title": "Error Rate",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "influxdb", "uid": "influxdb-k6" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red",    "value": 0.05 }
            ]
          },
          "unit": "percentunit",
          "decimals": 2
        }
      },
      "targets": [
        {
          "refId": "A",
          "query": "SELECT mean(\"value\") FROM \"http_req_failed\" WHERE $timeFilter GROUP BY time(10s) fill(0)",
          "resultFormat": "time_series",
          "rawQuery": true
        }
      ]
    },

    {
      "id": 5,
      "title": "Virtual Users over Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "influxdb", "uid": "influxdb-k6" },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20,
            "pointSize": 3,
            "showPoints": "never"
          },
          "unit": "short"
        }
      },
      "targets": [
        {
          "refId": "A",
          "query": "SELECT last(\"value\") FROM \"vus\" WHERE $timeFilter GROUP BY time($__interval) fill(0)",
          "resultFormat": "time_series",
          "rawQuery": true,
          "alias": "VUs"
        },
        {
          "refId": "B",
          "query": "SELECT last(\"value\") FROM \"vus_max\" WHERE $timeFilter GROUP BY time($__interval) fill(0)",
          "resultFormat": "time_series",
          "rawQuery": true,
          "alias": "VUs Max"
        }
      ]
    },

    {
      "id": 6,
      "title": "Request Rate (req/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "influxdb", "uid": "influxdb-k6" },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "reqps"
        }
      },
      "targets": [
        {
          "refId": "A",
          "query": "SELECT non_negative_derivative(max(\"value\"), 1s) FROM \"http_reqs\" WHERE $timeFilter GROUP BY time($__interval) fill(0)",
          "resultFormat": "time_series",
          "rawQuery": true,
          "alias": "req/s"
        }
      ]
    },

    {
      "id": 7,
      "title": "Response Latency Percentiles (chat_e2e_latency_ms)",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 12 },
      "datasource": { "type": "influxdb", "uid": "influxdb-k6" },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max", "p95"] }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "never"
          },
          "unit": "ms"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "P99" },
            "properties": [{ "id": "custom.lineWidth", "value": 1 },
                           { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          },
          {
            "matcher": { "id": "byName", "options": "P95" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }]
          },
          {
            "matcher": { "id": "byName", "options": "P50 (median)" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "query": "SELECT percentile(\"value\", 50) FROM \"chat_e2e_latency_ms\" WHERE $timeFilter GROUP BY time($__interval) fill(null)",
          "resultFormat": "time_series",
          "rawQuery": true,
          "alias": "P50 (median)"
        },
        {
          "refId": "B",
          "query": "SELECT percentile(\"value\", 90) FROM \"chat_e2e_latency_ms\" WHERE $timeFilter GROUP BY time($__interval) fill(null)",
          "resultFormat": "time_series",
          "rawQuery": true,
          "alias": "P90"
        },
        {
          "refId": "C",
          "query": "SELECT percentile(\"value\", 95) FROM \"chat_e2e_latency_ms\" WHERE $timeFilter GROUP BY time($__interval) fill(null)",
          "resultFormat": "time_series",
          "rawQuery": true,
          "alias": "P95"
        },
        {
          "refId": "D",
          "query": "SELECT percentile(\"value\", 99) FROM \"chat_e2e_latency_ms\" WHERE $timeFilter GROUP BY time($__interval) fill(null)",
          "resultFormat": "time_series",
          "rawQuery": true,
          "alias": "P99"
        }
      ]
    },

    {
      "id": 8,
      "title": "Error Rate over Time",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 21 },
      "datasource": { "type": "influxdb", "uid": "influxdb-k6" },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "red" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never"
          },
          "unit": "percentunit",
          "min": 0,
          "max": 1
        }
      },
      "targets": [
        {
          "refId": "A",
          "query": "SELECT mean(\"value\") FROM \"http_req_failed\" WHERE $timeFilter GROUP BY time($__interval) fill(0)",
          "resultFormat": "time_series",
          "rawQuery": true,
          "alias": "error rate"
        }
      ]
    },

    {
      "id": 9,
      "title": "http_req_duration Percentiles (raw k6 metric)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 21 },
      "datasource": { "type": "influxdb", "uid": "influxdb-k6" },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "never"
          },
          "unit": "ms"
        }
      },
      "targets": [
        {
          "refId": "A",
          "query": "SELECT percentile(\"value\", 50) FROM \"http_req_duration\" WHERE $timeFilter GROUP BY time($__interval) fill(null)",
          "resultFormat": "time_series",
          "rawQuery": true,
          "alias": "P50"
        },
        {
          "refId": "B",
          "query": "SELECT percentile(\"value\", 95) FROM \"http_req_duration\" WHERE $timeFilter GROUP BY time($__interval) fill(null)",
          "resultFormat": "time_series",
          "rawQuery": true,
          "alias": "P95"
        },
        {
          "refId": "C",
          "query": "SELECT percentile(\"value\", 99) FROM \"http_req_duration\" WHERE $timeFilter GROUP BY time($__interval) fill(null)",
          "resultFormat": "time_series",
          "rawQuery": true,
          "alias": "P99"
        }
      ]
    }

  ]
}
