# Copy to .env and fill in. All vars here are consumed by docker-compose.yml.

# -----------------------------------------------------------------------------
# OpenRouter (used in place of OpenAI by chat-orch and conversation-chat).
# The services read OPENAI_API_KEY internally — compose injects this value
# there and overrides OPENAI_BASE_URL to point at OpenRouter.
# Get a key at https://openrouter.ai/keys
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME

# -----------------------------------------------------------------------------
# JWT signing secret for Tenant Service (login handler).
# -----------------------------------------------------------------------------
JWT_SECRET=dev-change-me-to-a-long-random-string

# -----------------------------------------------------------------------------
# Supabase Postgres (hosted). Replace YOUR-PASSWORD with the real one.
# sslmode=require is mandatory — Supabase rejects plaintext connections.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.xxizwqfqpiscfhsnadme.supabase.co:5432/postgres?sslmode=require

# -----------------------------------------------------------------------------
# MongoDB Atlas (hosted). Paste the SRV URI from the Atlas "Connect" dialog.
# -----------------------------------------------------------------------------
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=conversatory

# -----------------------------------------------------------------------------
# LLM model + endpoint (OpenRouter-compatible). Both are optional — compose
# falls back to the defaults shown below. Override here to swap models or
# point at a self-hosted gateway.
# -----------------------------------------------------------------------------
# OPENAI_DEFAULT_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# -----------------------------------------------------------------------------
# Frontend — Vite inlines these at *build* time (compose passes them as
# build.args). The frontend nginx now reverse-proxies every API path back to
# the right backend, so the browser stays on a single origin and the defaults
# below are empty / relative. Override only for builds that need to hit a
# separate API host (e.g. a staging frontend pointing at a remote gateway).
# -----------------------------------------------------------------------------
# VITE_TENANT_API_URL=
# VITE_ORCH_API_URL=
# VITE_METRICAS_API_URL=
# VITE_CHAT_API_URL=/api/v1

# -----------------------------------------------------------------------------
# Telegram long-poll integration (leave empty to disable the bot channel).
# Get a token from @BotFather. The orch still runs without these.
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_TENANT_ID=demo-tenant

# -----------------------------------------------------------------------------
# Twilio voice channel (out of scope today — see AGENTS.md §11). Leave empty
# to disable. Generate the credentials in the Twilio Console:
#   • Account SID + Auth Token   → Console → Account → API keys & tokens
#   • API Key SID + Secret       → Console → Account → API keys & tokens
#                                  → Create API Key (use a Standard key, copy
#                                  the secret immediately — it shows once).
#   • TwiML App SID              → Console → Voice → TwiML → TwiML Apps
#                                  → Create new TwiML App.
# Account SID + Auth Token are enough for REST calls. API Key + Secret are
# required to sign Access Tokens (JWTs) for the @twilio/voice-sdk client.
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
TWILIO_DEFAULT_TENANT_ID=demo-tenant

# -----------------------------------------------------------------------------
# Compliance service. Audit logs land in the local email-mongo container by
# default; point MONGO_URI_COMPLIANCE at Atlas (or another host) to override.
# -----------------------------------------------------------------------------
# MONGO_URI_COMPLIANCE=mongodb://email-mongo:27017
# MONGO_DB_COMPLIANCE=UN_compliance_db

# -----------------------------------------------------------------------------
# Hospital-MP local Postgres. Schema + seed are baked in via the
# hospital-postgres container's init scripts. These defaults match the
# in-tree fixture credentials — change them for any environment that's
# reachable from the public internet.
# -----------------------------------------------------------------------------
# HOSPITAL_DB_NAME=hospital
# HOSPITAL_DB_USER=hospital
# HOSPITAL_DB_PASSWORD=hospital

# -----------------------------------------------------------------------------
# Email service (UN_email_send_ms). Stores audit rows in the local
# email-mongo container (not Atlas), so MONGO_URI here is unused by it.
# Leave SENDGRID_SANDBOX_MODE=true in dev to skip real delivery.
# -----------------------------------------------------------------------------
SENDGRID_API_KEY=SG.REPLACE_ME
SENDGRID_SANDBOX_MODE=true
EMAIL_FROM_DEFAULT=noreply@unagent.local
# EMAIL_FROM_NAME=UN-AGENT Notifications
# MONGO_DB_EMAIL=email_audit
# EMAIL_AUTH_STUB=true

# -----------------------------------------------------------------------------
# Grafana (observability dashboards). Defaults are admin/admin — change them
# if the instance is exposed publicly.
# -----------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# -----------------------------------------------------------------------------
# CORS allow-list for chat-orch. Set to the public origin of the FrontEnd
# (Cloudflare Pages custom domain) in production. Defaults to localhost:3000
# for the local dev frontend container.
# -----------------------------------------------------------------------------
# CORS_ALLOW_ORIGIN=https://app.unagent.site

# -----------------------------------------------------------------------------
# CORS allow-list for the Tenant service (space-separated list of origins).
# Critical: must NOT be "*" — Tenant uses credentials (JWT).
# -----------------------------------------------------------------------------
# CORS_ALLOW_ORIGINS=https://app.unagent.site https://dev.unagent.site

# -----------------------------------------------------------------------------
# Rate-limit proxy header trust.
# Set to "true" ONLY in production behind Cloudflare (CF-Connecting-IP and
# X-Forwarded-For are then authoritative). Leave "false" (default) in local
# dev and any environment where these headers can be spoofed by clients.
# -----------------------------------------------------------------------------
# TRUST_PROXY_HEADERS=false

# -----------------------------------------------------------------------------
# LLM model override. Defaults inside compose to nemotron via OpenRouter.
# Switch to grok by uncommenting below, or any other OpenRouter slug.
# -----------------------------------------------------------------------------
# OPENAI_DEFAULT_MODEL=x-ai/grok-4-fast:free

# -----------------------------------------------------------------------------
# Secure Channel (AES-256-GCM) — wraps every backend-to-backend HTTP body
# and every RabbitMQ payload (chat_requests / chat_results) in an
# authenticated envelope. The Frontend stays outside this channel: Cloudflare
# TLS covers browser → backend, and the browser cannot be trusted with the
# shared key. Health endpoints stay plaintext for probes.
#
# Generate the key once and share it across every participating service:
#     openssl rand -base64 32
#
# Flip BACKEND_CHANNEL_ENABLED=true on every service simultaneously when
# you're ready to cut over. Leaving it false keeps the wire plaintext during
# rollout while the helpers + middleware are already deployed.
# -----------------------------------------------------------------------------
BACKEND_CHANNEL_KEY=
BACKEND_CHANNEL_ENABLED=false

# -----------------------------------------------------------------------------
# Rate limiting (Throttle Requests pattern — security scenario 4)
# -----------------------------------------------------------------------------
# Token-bucket throttles at the two most exposed surfaces:
#   * chat-orch /v1/chat and /v1/feedback — keyed by tenant_id. Defends
#     against LLM-cost denial-of-wallet and prevents one tenant from
#     starving the others.
#   * Tenant /auth/login — keyed by client IP (CF-Connecting-IP behind
#     Cloudflare Tunnel). Blunts brute-force / credential-stuffing
#     attacks against bcrypt-protected accounts.
#
# Each bucket is `BURST` tokens deep and refills at `PER_SEC` tokens per
# second. Defaults are tuned for a single-tenant demo; raise BURST for
# load tests, lower PER_SEC to make the throttle bite faster.
# -----------------------------------------------------------------------------
RATE_LIMIT_CHAT_BURST=20
RATE_LIMIT_CHAT_PER_SEC=1.0
RATE_LIMIT_FEEDBACK_BURST=10
RATE_LIMIT_FEEDBACK_PER_SEC=0.5
AUTH_RATE_LIMIT_BURST=5
AUTH_RATE_LIMIT_PER_SEC=0.0333
