# Cloudflare Worker — UNAgent gateway.
#
# Reference copy of the live `wrangler.toml` (which is gitignored). The old
# bootstrap script that filled {{PLACEHOLDERS}} is gone with the Railway
# deployment — backends now live on GKE behind two fixed API hostnames, so
# the values below are literal. If you edit `wrangler.toml` by hand, mirror
# the change here; to recreate a lost wrangler.toml, copy this file over it.
#
# Deploy:  cd cloudflare-worker && npx wrangler deploy --env dev|prod

name = "unagent-gateway"
main = "src/index.ts"
compatibility_date = "2026-01-15"
workers_dev = false

# Static SPA assets — the FrontEnd static export is mounted into the Worker so
# the same wrangler deploy uploads code AND assets in one shot.
[assets]
directory = "../FrontEnd/dist"
binding = "ASSETS"
not_found_handling = "single-page-application"

# ---------------------------------------------------------------------------
# dev — bound to dev.<apex>. Worker proxies to the GKE dev gateway
# (namespace unagent-dev; the in-cluster frontend nginx routes the paths).
# ---------------------------------------------------------------------------
[env.dev]
name = "unagent-gateway-dev"
routes = [{ pattern = "dev.unagent.site", custom_domain = true }]

[env.dev.vars]
BACKEND_ORCH       = "https://api-dev.unagent.site"
BACKEND_TENANT     = "https://api-dev.unagent.site"
BACKEND_CHAT       = "https://api-dev.unagent.site"
BACKEND_COMPLIANCE = "https://api-dev.unagent.site"
BACKEND_USER_AUTH  = "https://api-dev.unagent.site"

# ---------------------------------------------------------------------------
# prod — bound to <apex>. Worker proxies to the GKE prod gateway
# (namespace unagent-prod; the in-cluster frontend nginx routes the paths).
# ---------------------------------------------------------------------------
[env.prod]
name = "unagent-gateway-prod"
routes = [{ pattern = "unagent.site", custom_domain = true }]

[env.prod.vars]
BACKEND_ORCH       = "https://api.unagent.site"
BACKEND_TENANT     = "https://api.unagent.site"
BACKEND_CHAT       = "https://api.unagent.site"
BACKEND_COMPLIANCE = "https://api.unagent.site"
BACKEND_USER_AUTH  = "https://api.unagent.site"
